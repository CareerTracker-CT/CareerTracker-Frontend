# Frontend environment template
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/careertracker
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_API_URL=http://127.0.0.1:4000/api/v1

# Firebase Authentication (public web configuration — safe to expose).
# Server-side Firebase Admin credentials belong to the backend only and must
# never be added here or prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
